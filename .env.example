# Used by docker compose
# Leave ANTHROPIC_API_KEY empty to run in demo mode (offline scripted agent, no cost).
ANTHROPIC_API_KEY=
# QAPILOT_DEMO_MODE=true
# QAPILOT_MODEL=claude-opus-5-5
# QAPILOT_EFFORT=medium

# Free alternatives (see README, "Other LLM providers"). Ignored while ANTHROPIC_API_KEY is set,
# unless QAPILOT_PROVIDER says otherwise.
# GEMINI_API_KEY=                 # https://aistudio.google.com/apikey
# QAPILOT_PROVIDER=               # claude | gemini | ollama; empty = auto
# QAPILOT_GEMINI_MODEL=gemini-3.5-flash-lite
# QAPILOT_OLLAMA_BASE_URL=http://localhost:11434/v1
# QAPILOT_OLLAMA_MODEL=qwen3:14b
# QAPILOT_COMPAT_VISION=          # send screenshots as images; empty = on for Gemini, off for Ollama
# QAPILOT_COMPAT_CONTEXT_TOKENS=50000
